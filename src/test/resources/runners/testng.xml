<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Suite" parallel="tests" thread-count="4">
    <parameter name="browser" value="chrome"/>
    <test name="UI Tests - Chrome">
        <classes>
            <class name="runners.ChromeRunner"/>
        </classes>
    </test>
    <test name="UI Tests - Firefox">
        <classes>
            <class name="runners.FirefoxRunner"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="runners.ApiRunner"/>
        </classes>
    </test>
</suite>